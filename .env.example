# viaSocket embed project (viaSocket → Integrations → your embed → Install Code)
VIASOCKET_ORG_ID=
VIASOCKET_PROJECT_ID=
VIASOCKET_EMBED_SECRET=

# Generated on first start if missing. Keep them: losing the master key makes stored credentials unreadable.
DOCSTAR_MASTER_KEY=
DOCSTAR_ADMIN_PASSWORD=

# Live mirror to the hosted dashboard: the Mac pushes its numbers there and runs buttons pressed there.
# The hosted copy needs the same token as its SYNC_TOKEN env var.
# HOSTED_URL=https://docstar-agent.embarko.app
# HOSTED_SYNC_TOKEN=

# Optional
# PORT=4000
# DB_PATH=data/docstar.db
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_PROFILE_DIR=data/chrome-profile
# CHROME_DEBUG_PORT=9333
